{
  "name": "kassa",
  "version": "2.0.0",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test src/logic.test.js",
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "icon": "node scripts/make-icon.mjs"
  },
  "keywords": [],
  "author": "EkisWasTaken",
  "license": "ISC",
  "description": "Personlig ekonomi: utgifter, prenumerationer och sparande",
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "echarts": "5.6",
    "electron": "^36.9.5",
    "electron-builder": "^26.18.0",
    "vite": "^6.4.5",
    "vue": "3.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "type": "module",
  "productName": "Kassa",
  "build": {
    "appId": "se.kassa.app",
    "productName": "Kassa",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kassa"
    }
  }
}
